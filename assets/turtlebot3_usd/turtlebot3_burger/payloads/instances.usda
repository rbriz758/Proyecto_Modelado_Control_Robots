#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "burger_base" (
        prepend references = @./geometries.usd@</Geometries/burger_base>
    )
    {
        over "burger_base" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/burger_base/VisualMaterials/light_black>
        }

        def Scope "VisualMaterials"
        {
            def Material "light_black" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/light_black>
            )
            {
            }
        }
    }

    def Xform "left_tire" (
        prepend references = @./geometries.usd@</Geometries/left_tire>
    )
    {
        over "left_tire" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/left_tire/VisualMaterials/dark>
        }

        def Scope "VisualMaterials"
        {
            def Material "dark" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/dark>
            )
            {
            }
        }
    }

    def Xform "right_tire" (
        prepend references = @./geometries.usd@</Geometries/right_tire>
    )
    {
        over "right_tire" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/right_tire/VisualMaterials/dark>
        }

        def Scope "VisualMaterials"
        {
            def Material "dark" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/dark>
            )
            {
            }
        }
    }

    def Xform "lds" (
        prepend references = @./geometries.usd@</Geometries/lds>
    )
    {
        over "lds" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/lds/VisualMaterials/dark>
        }

        def Scope "VisualMaterials"
        {
            def Material "dark" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/dark>
            )
            {
            }
        }
    }
}

